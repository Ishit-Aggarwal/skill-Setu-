# ---------------------------------------------------------------------------
# Skill Setu environment configuration
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Two of these values must ALSO be set on the Convex deployment, not just here.
# See "Convex-side variables" at the bottom — getting this wrong is the single
# most common way to break signup, and /api/health will tell you if it is.
# ---------------------------------------------------------------------------

# --- Account database (REQUIRED) -------------------------------------------
# Accounts, sessions, graded skill-test results and mentorship scheduling all
# live here. Without it the app cannot sign anyone in.
# Run `npx convex dev` (development) or `npx convex deploy` (production) and
# paste the deployment URL it prints.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Email / OTP delivery (REQUIRED for registration) ----------------------
# Registration will not complete without a working mail transport.
#
# Option A — Gmail. EMAIL_PASS must be a 16-character Google "App Password"
# (Google Account > Security > 2-Step Verification > App passwords), NOT your
# normal account password. Plain passwords are rejected with an EAUTH error.
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=abcdefghijklmnop

# Option B — any SMTP provider (Mailtrap, Resend, SES, Postmark, a relay...).
# If SMTP_HOST is set it takes precedence over the Gmail settings above.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_FROM=no-reply@yourdomain.com

# Secret used to sign the stateless signup OTP tokens.
#
# The token is minted by this server and verified inside Convex, so BOTH sides
# need the same value. Set a long random string and set the identical value on
# the Convex deployment (see below) — if they differ, every verification code
# is rejected and nobody can register.
OTP_SECRET=change-me-to-a-long-random-string

# Offline development escape hatch. When "true" AND no mail transport is
# configured, the OTP is shown on screen instead of emailed. The code still has
# to be typed in — verification is never skipped. Never enable in production.
# OTP_DEV_MODE=true

# --- Optional --------------------------------------------------------------
# Used to build absolute links in password-reset emails. Falls back to the
# request's own host, which is usually right on Vercel.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# The AI skill-gap roadmap calls Gemini when this is set, and falls back to a
# deterministic rule-based generator when it isn't. The UI labels which one
# produced the analysis either way, so leaving this unset is a valid choice.
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Convex-side variables
#
# These are set on the Convex deployment, NOT in this file:
#
#   npx convex env set OTP_SECRET "<the same value as above>"
#
# Confirm both sides agree by opening /api/health on the running app. It
# reports whether Convex is reachable, whether it can read and write, and
# whether the OTP secret matches — without printing any secret.
# ---------------------------------------------------------------------------
